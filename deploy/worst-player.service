[Unit]
Description=Discord Worst Player Finder
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=worst-player
Group=worst-player
WorkingDirectory=/opt/discord-worst-player-finder/current
EnvironmentFile=/etc/discord-worst-player-finder/service.env
ExecStart=/usr/bin/flock -n -E 75 -F /var/lib/discord-worst-player-finder/service.lock /opt/discord-worst-player-finder/runtime/bin/node /opt/discord-worst-player-finder/current/dist/src/operations/cli.js start --config /etc/discord-worst-player-finder/service.json
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=75 78
TimeoutStopSec=75
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/discord-worst-player-finder
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
